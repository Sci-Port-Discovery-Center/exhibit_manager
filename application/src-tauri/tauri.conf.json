{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "exhibit_manager",
  "mainBinaryName": "exhibit_manager",
  "version": "0.2.1",
  "identifier": "com.exhibit-manager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "security": {
      "csp": {
        "connect-src": "ipc: http://ipc.localhost http://localhost:3030 http://192.168.1.56:3030 https://picsum.photos",
        "img-src": "'self' asset: http://asset.localhost blob: data: https://picsum.photos https://fastly.picsum.photos http://192.168.1.56:3030 http://localhost:3030"
      }
    },
    "windows": [
      {
        "title": "exhibit_manager",
        "minWidth": 1700,
        "minHeight": 600,
        "width": 1800,
        "height": 900,
        "useHttpsScheme": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
